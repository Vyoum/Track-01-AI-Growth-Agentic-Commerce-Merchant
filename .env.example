# App
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DATABASE_URL=sqlite:///./backend/data/checkout_agent.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Demo defaults
DEMO_USER_ID=demo_user_01
# true = local JSON catalog; false + STORE_API_BASE_URL = live merchant adapter
USE_MOCK_CATALOG=true

# Merchant e-commerce API (Pointer 9)
# Leave empty to use mock JSON. For local adapter test against this app:
#   USE_MOCK_CATALOG=false
#   STORE_API_BASE_URL=http://127.0.0.1:8000/merchant-mock
STORE_API_BASE_URL=
STORE_API_KEY=
STORE_API_TIMEOUT_SECONDS=8
STORE_API_MAX_RETRIES=1
STORE_FALLBACK_TO_MOCK=true
STORE_PRODUCTS_PATH=/products
STORE_PRODUCT_PATH=/products/{id}
STORE_USUAL_ORDER_PATH=/customers/{user_id}/orders/latest

# Groq — agent + tool calling (Pointer 8)
# Get key: https://console.groq.com/keys
GROQ_API_KEY=
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
LLM_BASE_URL=https://api.groq.com/openai/v1

# Razorpay — TEST MODE ONLY
# Key ID must start with rzp_test_
# Leave placeholders to use local mock verify; paste real test keys for dashboard transactions.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=replace_me
RAZORPAY_MODE=test
